DATABASE_URL=postgres://localmeals:localmeals@localhost:5432/localmeals
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Extra browser origins (comma-separated) allowed by API CORS besides WEB_ORIGIN / localhost:3000
# CORS_ORIGINS=https://staging.example.com
# Browser uses Next rewrite /lm-api → this URL (HttpOnly session cookie stays first-party).
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
# Optional: API_INTERNAL_URL for server-side / rewrite upstream (defaults to NEXT_PUBLIC_API_URL)
# Set NEXT_PUBLIC_API_PROXY=false only to call the API origin directly from the browser.
#
# Temporary single-kitchen launch — CSK Homemade Delights (unset to restore multi-cook):
NEXT_PUBLIC_SOLO_KITCHEN_SLUG=csk-homemade-delights
SOLO_KITCHEN_SLUG=csk-homemade-delights
# Optional without solo: hide enroll CTAs only
# NEXT_PUBLIC_HIDE_COOK_ONBOARD=true
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW=1 minute
# Menu/concern photos: leave unset for local disk (apps/api/uploads).
# On Cloud Run set to the Terraform uploads bucket name:
# GCS_UPLOADS_BUCKET=home-food-513806-localmeals-uploads
# Optional OpenTelemetry (OTLP). Packages are optionalDependencies.
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Staging smoke: SMOKE_API_URL=https://….run.app node scripts/smoke-staging.mjs

# Production lunch lock is 08:00; use 23 for after-hours local demos
LUNCH_CUTOFF_HOUR=8
LUNCH_CUTOFF_MINUTE=0
MOCK_PAYMENTS=true
MOCK_WHATSAPP=true
# Phone OTP login (dev OTP always 123456 when MOCK_AUTH!=false)
# When MOCK_AUTH=false, OTP is hashed in DB and sent via WhatsApp.
MOCK_AUTH=true
AUTH_SECRET=localmeals-dev-auth-secret
ADMIN_MOBILES=+919900000001
# Obscure browser path for ops console (default lm-ops-k7v2m9). Do not use "admin".
# NEXT_PUBLIC_ADMIN_PATH=lm-ops-k7v2m9
# Admin/ops Bearer enforcement. Unset → true in NODE_ENV=production; false locally.
# Kitchen mutators always require COOK/ADMIN Bearer regardless of this flag.
AUTH_ENFORCE=false
ENABLE_AUTO_CUTOFF=false
ENABLE_AUTO_EOD=false
# Shared secret for Cloud Scheduler + worker → /internal/cutoffs|settlements
# Required when NODE_ENV=production. Also send as header X-Internal-Token.
INTERNAL_JOB_TOKEN=
# Real Meta WABA (unused when MOCK_WHATSAPP=true)
# Create at developers.facebook.com → WhatsApp → API Setup
# Verify token: openssl rand -hex 16  (must match Meta webhook verify)
# Smoke: node scripts/smoke-whatsapp.mjs
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Optional: WHATSAPP_SMOKE_TO=91XXXXXXXXXX
# Real Razorpay (unused when MOCK_PAYMENTS=true)
# Webhook events: payment_link.paid (preferred), payment.captured
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Partner logistics (Shadowfax / Porter / HTTP gateway) — see docs/LOGISTICS.md
# Default outside production: mock. Set MOCK_LOGISTICS=false + LOGISTICS_API_BASE_URL for real.
MOCK_LOGISTICS=true
# LOGISTICS_PROVIDER=http
# LOGISTICS_API_BASE_URL=https://your-gateway.example.com
# LOGISTICS_API_KEY=
# LOGISTICS_CREATE_PATH=/v1/shipments
# LOGISTICS_GET_PATH=/v1/shipments/{id}
# LOGISTICS_CANCEL_PATH=/v1/shipments/{id}/cancel
# LOGISTICS_API_TIMEOUT_MS=15000
# LOGISTICS_API_EXTRA_HEADERS={"X-Vendor":"shadowfax"}
# Webhook: POST /webhooks/logistics — required in production
# LOGISTICS_WEBHOOK_SECRET=
# LOGISTICS_WEBHOOK_HMAC_SECRET=
