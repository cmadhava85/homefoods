project_id  = "home-food-513806"
region      = "asia-south1"
name_prefix = "localmeals"
db_tier     = "db-f1-micro"
# false = don't manage APIs in TF (avoids ADC 403 when already enabled)
enable_apis = false

# Admin phone(s) for first AUTH_SECRET / ADMIN_MOBILES seed
admin_mobiles = "+919900000001"

# --- Solo launch cost profile ---
solo_kitchen_slug    = "csk-homemade-delights" # "" when multi-cook
create_pubsub        = false                   # DB outbox only; enable later if needed
otel_enabled         = false
worker_min_instances = 1                       # staging idle: 0 (or ./scripts/cost-sleep-staging.sh)
api_min_instances    = 0
web_min_instances    = 0
outbox_poll_ms       = 5000
db_pool_max_api      = 5
db_pool_max_worker   = 2
uploads_nearline_days = 30
uploads_delete_days   = 180
artifact_keep_versions = 5
db_disk_autoresize_limit_gb = 20

# Flip on after first images are in Artifact Registry
create_cloud_run = false
# api_image    = "asia-south1-docker.pkg.dev/home-food-513806/localmeals/api:latest"
# worker_image = "asia-south1-docker.pkg.dev/home-food-513806/localmeals/worker:latest"
# web_image    = "asia-south1-docker.pkg.dev/home-food-513806/localmeals/web:latest"
# web_public_api_url = "https://localmeals-api-xxxxx-as.a.run.app"
# web_origin         = "https://localmeals-web-xxxxx-as.a.run.app"

# Scheduler (cut-off 08:00 + EOD 18:00 IST) — created when API Cloud Run exists
create_scheduler = true

# Keep mocks on until webhooks are public
mock_payments = true
mock_whatsapp = true
mock_auth     = true
auth_enforce  = true

# Optional
# alert_email        = "you@example.com"   # creates log-based metrics + alert policies
# otel_exporter_otlp_endpoint = ""         # leave empty; keep otel_enabled=false for solo
# confirming_stuck_ms = 900000
# api_custom_domain  = "api.localmeals.in"
# web_custom_domain  = "app.localmeals.in"
# create_tf_state_bucket = true
# tf_state_bucket_name   = "home-food-513806-tfstate"

# GitHub Actions → Cloud Run (Workload Identity)
# create_github_wif = true
# github_repository = "YOUR_USER/localmeals"

# --- Production readiness ---
# db_tier              = "db-g1-small"   # f1-micro: shared core, no SLA, ~25 connections
# db_availability_type = "REGIONAL"      # HA failover (~2x DB cost)
# db_pitr_enabled      = true
# db_log_retention_days    = 7
# db_backup_retained_count = 14
# alert_email          = "ops@example.com"  # enables uptime checks + all alert policies
# billing_account_id   = "XXXXXX-XXXXXX-XXXXXX"
# monthly_budget_inr   = 5000
# vpc_connector_enabled = false   # only for private-IP resources; prefer Direct VPC egress
