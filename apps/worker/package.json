{
  "name": "@localmeals/worker",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json --noCheck",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 src/*.test.ts",
    "test:coverage": "node ../../scripts/node-test-coverage.mjs --lines 94 --branches 80 --functions 70 --serial"
  },
  "dependencies": {
    "@localmeals/adapters": "*",
    "@localmeals/db": "*",
    "@localmeals/domain": "*",
    "@localmeals/observability": "*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.2"
  }
}
