{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --config vitest.config.mts"
  },
  "mutate": [
    "src/lib/**/*.ts",
    "!src/lib/**/*.test.ts",
    "!src/lib/api.ts",
    "!src/lib/auth.ts"
  ],
  "ignorePatterns": [
    ".next",
    "reports",
    ".stryker-tmp",
    "src/app/**",
    "src/components/**",
    "src/middleware.ts"
  ],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/web.html" },
  "jsonReporter": { "fileName": "reports/mutation/web.json" },
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 30000,
  "timeoutFactor": 1.5,
  "incremental": true,
  "incrementalFile": "reports/mutation/web-incremental.json",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "disableTypeChecks": "{src,lib}/**/*.{js,ts,jsx,tsx,html,vue}",
  "tempDirName": ".stryker-tmp"
}
