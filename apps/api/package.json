{
  "name": "@localmeals/api",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json --noCheck",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-all-tests.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:mutation": "stryker run",
    "test:mutation:full": "stryker run stryker.full.config.json",
    "test:coverage": "node ../../scripts/node-test-coverage.mjs --lines 75 --branches 63 --functions 73 --serial",
    "openapi": "node --import tsx src/openapi/generate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@google-cloud/storage": "^7.16.0",
    "@localmeals/adapters": "*",
    "@localmeals/db": "*",
    "@localmeals/domain": "*",
    "@localmeals/i18n": "*",
    "@localmeals/observability": "*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "zod-to-json-schema": "^3.25.2"
  }
}
