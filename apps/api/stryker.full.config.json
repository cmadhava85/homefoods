{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm test"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/index.ts",
    "!src/testHelpers.ts"
  ],
  "ignorePatterns": ["dist", "uploads", "reports", ".stryker-tmp"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/api-full.html" },
  "jsonReporter": { "fileName": "reports/mutation/api-full.json" },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "timeoutFactor": 2,
  "incremental": true,
  "incrementalFile": "reports/mutation/api-full-incremental.json",
  "thresholds": {
    "high": 70,
    "low": 50,
    "break": null
  },
  "disableTypeChecks": "{src,lib}/**/*.{js,ts,jsx,tsx,html,vue}",
  "tempDirName": ".stryker-tmp"
}
