{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm run test:unit"
  },
  "mutate": [
    "src/httpErrors.ts",
    "src/prodConfig.ts",
    "src/http/orderViews.ts",
    "src/uploads.ts",
    "src/services/turnoverReports.ts"
  ],
  "ignorePatterns": [
    "dist",
    "uploads",
    "reports",
    ".stryker-tmp",
    "src/plugins/**",
    "src/wa/**",
    "src/app.ts",
    "src/index.ts",
    "src/telemetry.ts",
    "src/env.ts"
  ],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/api.html" },
  "jsonReporter": { "fileName": "reports/mutation/api.json" },
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 60000,
  "timeoutFactor": 1.5,
  "ignoreMethods": [
    "getTurnoverReport",
    "gcsClient",
    "writeGcsObject",
    "registerApiErrorHandler",
    "sendCaughtError",
    "localeFromReply"
  ],
  "incremental": true,
  "incrementalFile": "reports/mutation/api-incremental.json",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "disableTypeChecks": "{src,lib}/**/*.{js,ts,jsx,tsx,html,vue}",
  "tempDirName": ".stryker-tmp"
}
