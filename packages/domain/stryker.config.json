{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "buildCommand": "tsc -p tsconfig.json",
  "commandRunner": {
    "command": "node --test --test-concurrency=1 'dist/**/*.test.js'"
  },
  "mutate": ["src/**/*.ts", "!src/**/*.test.ts"],
  "ignorePatterns": ["reports", ".stryker-tmp"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/domain.html" },
  "jsonReporter": { "fileName": "reports/mutation/domain.json" },
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 30000,
  "timeoutFactor": 1.5,
  "incremental": true,
  "incrementalFile": "reports/mutation/domain-incremental.json",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "disableTypeChecks": "{src,lib}/**/*.{js,ts,jsx,tsx,html,vue}",
  "tempDirName": ".stryker-tmp"
}
